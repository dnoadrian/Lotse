# Quitly – Konfiguration für docker compose
# Kopieren nach .env (oder scripts/generate-env.sh ausführen) und anpassen.
# .env enthält Geheimnisse: chmod 600 .env, niemals einchecken.

# ---------------------------------------------------------------- Domain & HTTPS
# Öffentlicher Name, unter dem Quitly erreichbar ist (ohne https://)
QUITLY_DOMAIN=quitly.example.org
# Let's-Encrypt-Kontaktadresse für eine öffentliche Domain – oder "internal" für eine eigene,
# lokale Zertifizierungsstelle (LAN, Tests; Browser zeigen dann eine Warnung, bis die Caddy-CA vertraut wird)
QUITLY_TLS=admin@example.org

# ---------------------------------------------------------------- Geheimnisse (Pflicht)
# Jeweils 32 zufällige Bytes, base64:  openssl rand -base64 32
QUITLY_SECRET_KEY=
# Schlüssel für AES-256-GCM-Verschlüsselung der Postfach-Zugangsdaten. NICHT verlieren:
# Ohne ihn sind gespeicherte Zugangsdaten unbrauchbar (Postfächer müssen neu verbunden werden).
QUITLY_ENCRYPTION_KEY=
# Bei Schlüsselwechsel: alten Schlüssel hier eintragen (kommagetrennt), neuen oben
QUITLY_ENCRYPTION_KEYS_OLD=

# Datenbank-Passwort (nur Buchstaben/Ziffern):  openssl rand -hex 24
POSTGRES_PASSWORD=

# ---------------------------------------------------------------- Sitzungen & Schutz
QUITLY_SESSION_IDLE_MINUTES=30
QUITLY_SESSION_ABSOLUTE_HOURS=12
QUITLY_LOGIN_MAX_ATTEMPTS=5
QUITLY_LOGIN_WINDOW_MINUTES=15
QUITLY_LOGIN_IP_MAX_ATTEMPTS=20

# ---------------------------------------------------------------- Mailcow / IMAP
# Erlaubte IMAP-Ports (Standard: nur IMAPS 993)
QUITLY_IMAP_ALLOWED_PORTS=993
# Mailserver, die auf interne/private Adressen auflösen dürfen (z. B. Mailcow im selben LAN).
# Alle anderen Server müssen öffentliche IP-Adressen haben (SSRF-Schutz).
QUITLY_IMAP_ALLOWED_HOSTS=
# Pfad (im Container) zu einer zusätzlichen CA-Datei, falls der Mailserver ein eigenes Zertifikat nutzt.
# Zertifikate werden IMMER geprüft – es gibt keine Option, die Prüfung abzuschalten.
QUITLY_IMAP_CA_FILE=

# ---------------------------------------------------------------- Gmail (optional)
# OAuth-Client aus der Google Cloud Console (Typ "Webanwendung"), siehe docs/GMAIL.md
# Weiterleitungs-URI dort eintragen: https://<QUITLY_DOMAIN>/api/oauth/google/callback
QUITLY_GOOGLE_CLIENT_ID=
QUITLY_GOOGLE_CLIENT_SECRET=
